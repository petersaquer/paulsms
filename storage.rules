rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Solo usuarios autenticados pueden subir o leer archivos multimedia de chat y estados
    match /chat_media/{chatId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024; // 50MB max
    }
    match /voice_notes/{chatId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024; // 25MB max
    }
    match /statuses/{statusId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 30 * 1024 * 1024; // 30MB max
      allow delete: if request.auth != null;
    }
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
