rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData(request.auth.uid).role == 'ADMIN';
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Perfiles de usuario y subcolecciones
    match /users/{userId} {
      allow read: if isAuthenticated();
      // En registro sólo se permite rol 'USER'; creación administrativa protegida
      allow create: if isUser(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'USER');
      // Usuario no puede alterar su propio rol ni auto-desbanearse
      allow update: if isUser(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == resource.data.isBanned);
      allow delete: if isUser(userId) || isAdmin();

      // Contactos guardados
      match /saved_contacts/{contactId} {
        allow read, write: if isUser(userId);
      }

      // Copias de seguridad en la nube (Room Database snapshots)
      match /backups/{backupId} {
        allow read, write: if isUser(userId);
      }
    }

    // Chats 1:1 o grupales
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      // Creación: debe ser participante. Chats 1:1 exigen exactamente 2 participantes
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        (request.resource.data.type != 'DIRECT' || (request.resource.data.participants.size() == 2 && chatId.matches('^direct_.*')));
      // Actualización: no se pueden alterar participantes en chats 1:1
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants &&
        (resource.data.type == 'GROUP' || request.resource.data.participants == resource.data.participants);
      // Borrado global de chat deshabilitado; se gestiona por usuario vía campo deletedFor/clearedAt
      allow delete: if false;

      // Configuración avanzada de grupos (roles, permisos, invitaciones)
      match /group_config/{docId} {
        allow read: if isChatParticipant(chatId);
        allow write: if isChatParticipant(chatId);
      }

      // Mensajes del chat
      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        // Creación: solo el remitente autenticado puede enviar su propio mensaje, texto max 4000 caracteres
        allow create: if isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.chatId == chatId &&
          (!('text' in request.resource.data) || request.resource.data.text.size() <= 4000);
        // Actualización: inmutabilidad de senderId, chatId y createdAt; ventana de edición para autor, o actualización de campos permitidos por participantes
        allow update: if isChatParticipant(chatId) &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.chatId == resource.data.chatId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          ((resource.data.senderId == request.auth.uid && request.time.toMillis() - resource.data.createdAt < 172800000) ||
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'hasBeenViewed', 'status', 'pollData', 'isStarred', 'starredBy', 'deletedFor']));
        // Eliminación autorizada sólo por el autor del mensaje
        allow delete: if isChatParticipant(chatId) && resource.data.senderId == request.auth.uid;
      }
    }

    // Historias y Estados de 24 horas
    match /statuses/{statusId} {
      // Creación: solo el propio usuario; expiración máxima de 24 horas
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.expiresAt <= request.time.toMillis() + 86400000;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Lectura: autor o respetando la lista visibleTo calculada y expiración temporal
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.expiresAt > request.time.toMillis() && (
          resource.data.privacy == 'PUBLIC' ||
          ('visibleTo' in resource.data && request.auth.uid in resource.data.visibleTo) ||
          (resource.data.privacy == 'MY_CONTACTS_EXCEPT' && !(request.auth.uid in resource.data.excludedUserIds)) ||
          (resource.data.privacy == 'ONLY_SHARE_WITH' && request.auth.uid in resource.data.includedUserIds)
        ))
      );
      // Inmutabilidad de userId, privacy y expiresAt tras la creación
      allow update: if isAuthenticated() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.privacy == resource.data.privacy &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        (resource.data.userId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));

      // Subcolección views como fuente única de verdad para registro de visualizaciones
      match /views/{viewId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/statuses/$(statusId)).data.userId == request.auth.uid;
        allow create: if isAuthenticated() && viewId == request.auth.uid && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Registros de auditoría y reportes
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Configuración del sistema de la app
    match /app_system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
