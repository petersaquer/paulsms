rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /statuses/{statusId} {
      allow read, write: if true;
    }

    match /users/{userId}/saved_contacts/{contactId} {
      allow read, write: if true;
    }

    match /app_system/{docId} {
      allow read, write: if true;
    }
  }
}
