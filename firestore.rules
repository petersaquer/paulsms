rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfiles de usuario: Lectura autenticada (para búsqueda de contactos), Escritura solo por el propio usuario autenticado
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role != 'ADMIN');
      allow update: if request.auth != null && request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Contactos guardados del usuario
      match /saved_contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Chats 1:1 o de grupo: Solo lectura y escritura por participantes autenticados
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;

      // Mensajes de un chat: El autor solo puede crear sus propios mensajes, y solo el autor o reacciones autorizadas pueden actualizar
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          (resource.data.senderId == request.auth.uid ||
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'hasBeenViewed', 'status', 'pollData', 'isStarred']));
        allow delete: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // Colección de Estados/Historias de 24 horas y subcolección de vistas
    match /statuses/{statusId} {
      // Creación: Solo el autor puede subir su estado
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Eliminación: Solo el autor puede borrar su propio estado
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Lectura: Autor o usuarios autorizados por privacidad y no expirados (expiresAt > Date.now)
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (resource.data.expiresAt > request.time.toMillis() && (
          resource.data.privacy == 'PUBLIC' ||
          resource.data.privacy == 'MY_CONTACTS' ||
          (resource.data.privacy == 'MY_CONTACTS_EXCEPT' && !(request.auth.uid in resource.data.excludedUserIds)) ||
          (resource.data.privacy == 'ONLY_SHARE_WITH' && request.auth.uid in resource.data.includedUserIds)
        ))
      );

      // Actualización: Autor modifica o lectores interactúan (reacciones)
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'viewers'])
      );

      // Subcolección 'views' para registro idempotente de visualizaciones
      match /views/{viewId} {
        // Solo el autor del estado puede leer quién lo vio
        allow read: if request.auth != null && 
          get(/databases/$(database)/documents/statuses/$(statusId)).data.userId == request.auth.uid;

        // Registro de vista idempotente: Cada usuario solo puede escribir su propio ID de vista (viewId == uid)
        allow create: if request.auth != null && viewId == request.auth.uid && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Configuración del sistema de la aplicación
    match /app_system/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
  }
}
